{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "checkout",
    "namespace": "shop",
    "labels": {
      "app": "checkout"
    }
  },
  "spec": {
    "serviceAccountName": "checkout",
    "initContainers": [
      {
        "name": "init-config",
        "image": "registry.example.com/init-config:1.4.0",
        "volumeMounts": [
          {
            "name": "config",
            "mountPath": "/etc/config"
          }
        ]
      }
    ],
    "containers": [
      {
        "name": "app",
        "image": "registry.example.com/checkout:2.9.1",
        "env": [
          {
            "name": "DB_PASSWORD",
            "valueFrom": {
              "secretKeyRef": {
                "name": "checkout-db",
                "key": "password"
              }
            }
          },
          {
            "name": "LOG_LEVEL",
            "value": "info"
          }
        ],
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "128Mi"
          }
        },
        "volumeMounts": [
          {
            "name": "config",
            "mountPath": "/etc/config"
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "config",
        "configMap": {
          "name": "checkout-config"
        }
      }
    ]
  }
}
