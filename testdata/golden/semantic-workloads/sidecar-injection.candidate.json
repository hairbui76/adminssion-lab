{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "checkout",
    "namespace": "shop",
    "labels": {
      "app": "checkout"
    }
  },
  "spec": {
    "serviceAccountName": "checkout",
    "initContainers": [],
    "containers": [
      {
        "name": "app",
        "image": "registry.example.com/checkout:2.9.1",
        "env": [
          {
            "name": "DB_PASSWORD",
            "value": "s3cr3t-checkout-password"
          },
          {
            "name": "LOG_LEVEL",
            "value": "info"
          }
        ],
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "128Mi"
          }
        },
        "volumeMounts": [
          {
            "name": "config",
            "mountPath": "/etc/config"
          },
          {
            "name": "istio-envoy",
            "mountPath": "/var/run/secrets/istio",
            "readOnly": true
          }
        ]
      },
      {
        "name": "istio-proxy",
        "image": "docker.io/istio/proxyv2:1.29.0",
        "env": [
          {
            "name": "ISTIO_META_WORKLOAD_NAME",
            "value": "checkout"
          },
          {
            "name": "PROXY_CONFIG_TOKEN",
            "value": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.injected"
          }
        ],
        "volumeMounts": [
          {
            "name": "istio-envoy",
            "mountPath": "/var/run/secrets/istio",
            "readOnly": true
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "config",
        "configMap": {
          "name": "checkout-config"
        }
      },
      {
        "name": "istio-envoy",
        "emptyDir": {
          "medium": "Memory"
        }
      }
    ]
  }
}
