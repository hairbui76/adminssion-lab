            "name": "PROXY_MODE",
            "value": "sidecar"
          },
          {
            "name": "ADDRESS",
            "value": "0.0.0.0:15000"
          }
        ],
        "image": "registry.k8s.io/pause:3.10",
        "name": "proxy"
      },
      {
        "image": "registry.k8s.io/pause:3.10",
        "name": "app"
      },
      {
        "image": "registry.k8s.io/pause:3.10"
      }
    ],
    "initContainers": [
      {
        "image": "registry.k8s.io/pause:3.10",
        "name": "migrate-schema"
      },
      {
        "image": "registry.k8s.io/pause:3.10",
        "name": "await-database"
      }
    ],
    "volumes": [
      {
        "emptyDir": {},
        "name": "scratch"
      },
      {
