{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "unsorted-workload",
    "namespace": "admissionlab-fixtures",
    "uid": "b2c4d6e8-1111-4222-8333-444455556666"
  },
  "spec": {
    "containers": [
      {
