# An excerpt of a real kube-apiserver `/metrics` page, captured *before* a
# single serial fixture request (Task 3.8, Global Constraint 19). Trimmed
# to the two families `admissionlab_admission::metrics` reads plus enough
# neighbouring noise to prove the parser ignores everything else:
#
#   - `apiserver_admission_step_admission_duration_seconds` -- a real,
#     different family whose `_sum`/`_count` suffixes and
#     `operation`/`rejected`/`type` labels are identical to the webhook
#     family's. A prefix/suffix match sloppy enough to pick this up would
#     silently attribute built-in admission-plugin latency to a webhook.
#   - `apiserver_request_total` -- an unrelated counter with many labels.
#   - `etcd_request_duration_seconds` -- carries a label value with an
#     escaped quote, a comma, and a `}`, so a line scanner that split on
#     `,`/`}` without honouring quoting would mis-read it.
#   - `go_goroutines` -- a sample line with no label block at all.
#
# Paired with `after.prom`; see that file's header for exactly which
# delta case each webhook label set exercises.
# HELP apiserver_admission_step_admission_duration_seconds [ALPHA] Admission sub-step latency histogram in seconds, broken out for each operation and API resource and step type (validate or admit).
# TYPE apiserver_admission_step_admission_duration_seconds histogram
apiserver_admission_step_admission_duration_seconds_bucket{operation="CREATE",rejected="false",type="admit",le="0.005"} 118
apiserver_admission_step_admission_duration_seconds_bucket{operation="CREATE",rejected="false",type="admit",le="+Inf"} 118
apiserver_admission_step_admission_duration_seconds_sum{operation="CREATE",rejected="false",type="admit"} 0.0731
apiserver_admission_step_admission_duration_seconds_count{operation="CREATE",rejected="false",type="admit"} 118
# HELP apiserver_admission_webhook_admission_duration_seconds [ALPHA] Admission webhook latency histogram in seconds, identified by name and broken out for each operation and API resource and type (validate or admit).
# TYPE apiserver_admission_webhook_admission_duration_seconds histogram
apiserver_admission_webhook_admission_duration_seconds_bucket{name="deny.test.admissionlab.io",operation="CREATE",rejected="true",type="validate",le="0.25"} 3
apiserver_admission_webhook_admission_duration_seconds_bucket{name="deny.test.admissionlab.io",operation="CREATE",rejected="true",type="validate",le="+Inf"} 5
apiserver_admission_webhook_admission_duration_seconds_sum{name="deny.test.admissionlab.io",operation="CREATE",rejected="true",type="validate"} 0.5123
apiserver_admission_webhook_admission_duration_seconds_count{name="deny.test.admissionlab.io",operation="CREATE",rejected="true",type="validate"} 5
apiserver_admission_webhook_admission_duration_seconds_bucket{name="mutate.test.admissionlab.io",operation="CREATE",rejected="false",type="admit",le="0.005"} 5
apiserver_admission_webhook_admission_duration_seconds_bucket{name="mutate.test.admissionlab.io",operation="CREATE",rejected="false",type="admit",le="0.025"} 7
apiserver_admission_webhook_admission_duration_seconds_bucket{name="mutate.test.admissionlab.io",operation="CREATE",rejected="false",type="admit",le="+Inf"} 7
apiserver_admission_webhook_admission_duration_seconds_sum{name="mutate.test.admissionlab.io",operation="CREATE",rejected="false",type="admit"} 0.0411
apiserver_admission_webhook_admission_duration_seconds_count{name="mutate.test.admissionlab.io",operation="CREATE",rejected="false",type="admit"} 7
apiserver_admission_webhook_admission_duration_seconds_bucket{name="policy.kyverno.svc",operation="UPDATE",rejected="false",type="admit",le="+Inf"} 100
apiserver_admission_webhook_admission_duration_seconds_sum{name="policy.kyverno.svc",operation="UPDATE",rejected="false",type="admit"} 2.5
apiserver_admission_webhook_admission_duration_seconds_count{name="policy.kyverno.svc",operation="UPDATE",rejected="false",type="admit"} 100
apiserver_admission_webhook_admission_duration_seconds_bucket{name="validate.test.admissionlab.io",operation="CREATE",rejected="false",type="validate",le="+Inf"} 42
apiserver_admission_webhook_admission_duration_seconds_sum{name="validate.test.admissionlab.io",operation="CREATE",rejected="false",type="validate"} 1.2534
apiserver_admission_webhook_admission_duration_seconds_count{name="validate.test.admissionlab.io",operation="CREATE",rejected="false",type="validate"} 42
# HELP apiserver_admission_webhook_rejection_count [ALPHA] Admission webhook rejection count, identified by name and broken out for each admission type (validating or admitting) and operation. Additional labels specify an error type (calling_webhook_error or apiserver_internal_error if an error occurred; no_error otherwise) and optionally a non-zero rejection code if the webhook rejects the request with an HTTP status code (honored by the apiserver when the code is greater or equal to 400). Codes greater than 600 are truncated to 600, to keep the metrics cardinality bounded.
# TYPE apiserver_admission_webhook_rejection_count counter
apiserver_admission_webhook_rejection_count{error_type="calling_webhook_error",name="deny.test.admissionlab.io",operation="CREATE",rejection_code="0",type="validate"} 2
apiserver_admission_webhook_rejection_count{error_type="no_error",name="deny.test.admissionlab.io",operation="CREATE",rejection_code="400",type="validate"} 5
# HELP apiserver_request_total [STABLE] Counter of apiserver requests broken out for each verb, dry run value, group, version, resource, scope, component, and HTTP response code.
# TYPE apiserver_request_total counter
apiserver_request_total{code="201",component="apiserver",dry_run="All",group="",resource="configmaps",scope="namespace",subresource="",verb="POST",version="v1"} 118
# HELP etcd_request_duration_seconds [ALPHA] Etcd request latency in seconds for each operation and object type.
# TYPE etcd_request_duration_seconds histogram
etcd_request_duration_seconds_bucket{operation="get",type="*core.Pod\", tricky}",le="+Inf"} 5
# HELP go_goroutines Number of goroutines that currently exist.
# TYPE go_goroutines gauge
go_goroutines 412
